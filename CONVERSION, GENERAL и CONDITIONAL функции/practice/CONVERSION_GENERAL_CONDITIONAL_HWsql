-- Task 1: Using functions, retrieve a list of all employees whose names contain 
--         the letter 'b' (case-insensitive).
SELECT *
FROM employees e
WHERE INSTR(LOWER(e.first_name), 'b') > 0;

-- Task 2: Using functions, retrieve a list of all employees whose names contain
--         at least two 'a's.
SELECT *
FROM employees e
WHERE LOWER(e.first_name) LIKE '%a%a%';

SELECT *
FROM employees e
WHERE INSTR(LOWER(e.first_name), 'a', 1, 2) > 0;

-- Task 3: Retrieve the first word of the department name for departments with 
--         names consisting of more than one word.
SELECT
    d.department_name,
    SUBSTR(d.department_name, 1, INSTR(d.department_name, ' ') - 1) AS departmetn_name_short
FROM departments d
WHERE INSTR(d.department_name, ' ') > 0;

-- Task 4: Retrieve employee names with the first and last letters removed.
SELECT 
    e.first_name,
    SUBSTR(e.first_name, 2, LENGTH(e.first_name) - 2) AS first_name_short
FROM employees e;

-- Task 5: Retrieve a list of all employees where the `job_id` value has at least 
--         3 characters after the underscore ('_'), but the part after the underscore is not 'CLERK'.
SELECT *
FROM employees e
WHERE LENGTH(SUBSTR(e.job_id, INSTR(e.job_id, '_') + 1)) >= 3 
  AND SUBSTR(e.job_id, INSTR(e.job_id, '_') + 1) <> 'CLERK';
    
-- Task 6: Retrieve a list of all employees who started work on the first day of any month.
SELECT *
FROM employees e
WHERE TO_CHAR(e.hire_date, 'DD') = '01';

-- Task 7: Retrieve a list of all employees who started work in 2008.
SELECT *
FROM employees e
WHERE TO_CHAR(e.hire_date, 'YYYY') = '2008';

-- Task 8: Display tomorrow's date in the format: Tomorrow is Second day of January.
SELECT TO_CHAR(DATE '2026-01-02', 'fm"Tomorrow is "Ddspth "day of "Month') AS text
FROM dual;

-- Task 9: Display the employee's name and their start date in the format: 21st of June, 2007.
SELECT 
    e.first_name,
    e.hire_date,
    TO_CHAR(e.hire_date, 'fmDdth "of "Month", "YYYY') AS start_date_text
FROM employees e;

-- Task 10: Retrieve a list of employees with their salaries increased by 20%. 
--          Display the salary in the format: $28,800.00.
SELECT
    e.employee_id,
    e.first_name,
    e.last_name,
    e.salary,
    e.salary + (e.salary * 0.20) AS increased_salary,
    TO_CHAR(e.salary + (e.salary * 0.20), '$999,999.99') AS increased_salary_text
FROM employees e;

-- Task 11: Display the current date, plus a second, a minute, an hour, a day, 
--          a month, and a year (each added separately to the current date).
SELECT 
    SYSDATE                      AS now,
    SYSDATE + 1 / (24 * 60 * 60) AS plus_second,
    SYSDATE + 1 / (24 * 60)      AS plus_minute,
    SYSDATE + 1 / 24             AS plus_hour,
    SYSDATE + 1                  AS plus_day,
    ADD_MONTHS(SYSDATE, 1)       AS plus_month,
    ADD_MONTHS(SYSDATE, 12)      AS plus_year
FROM dual;

-- Task 12: Display the employee's name, their salary, and a new salary equal 
--          to the old salary plus the value represented by the text "$12,345.55".
SELECT
    e.employee_id,
    e.first_name,
    e.salary,
    e.salary + TO_NUMBER('$12,345.55', '$99,999.99') AS new_salary
FROM employees e;

-- Task 13: Display the employee's name, their start day, and the number of 
--          months between their start date and the date derived from the 
--          text "SEP, 18:45:00 18 2009". 
SELECT
    e.employee_id,
    e.first_name,
    e.hire_date,
    ROUND(
        MONTHS_BETWEEN(
            TO_DATE('SEP, 18:45:00 18 2009', 'MON, HH24:MI:SS DD YYYY'), 
                    e.hire_date
        )
    ) AS months_between
FROM employees e;
    
-- Task 14: Display the employee's name, salary, and total salary (salary + commission_pct) 
--          formatted as: $24,000.00.
SELECT 
    e.employee_id,
    e.first_name,
    e.salary,
    e.commission_pct,
    e.salary + (e.salary * NVL(e.commission_pct, 0)) AS new_salary,
    TO_CHAR(e.salary + (e.salary * NVL(e.commission_pct, 0)), '$99,999.00') AS new_salary_text
FROM employees e;

-- Task 15: Display the employee's first name, last name, and the string "different length" 
--          if the lengths differ, or "same length" if they are equal. Do not use 
--          conditional functions.
SELECT
    e.employee_id,
    e.first_name,
    e.last_name,
    NVL2(NULLIF(LENGTH(e.first_name), LENGTH(e.last_name)),
         'different length',
         'same length') AS result
FROM employees e;

-- Task 16: Display the employee's name, commission, and an indication of whether 
--          they receive a commission (Yes/No).
SELECT 
    e.employee_id,
    e.first_name,
    e.commission_pct,
    NVL2(e.commission_pct,
         'Yes',
         'No') AS has_bonus
FROM employees e;

-- Task 17: Display the employee's name and a value characterizing them: the commission 
--          amount (if present), otherwise the manager's ID (if present), otherwise the salary.
SELECT
    e.employee_id,
    e.first_name,
    e.commission_pct,
    e.manager_id,
    e.salary,
    COALESCE(e.commission_pct, e.manager_id, e.salary) AS first_not_null
FROM employees e;

-- Task 18: Display the employee's name, salary, and salary level: less than 5,000 
--          is "Low level"; 5,000 or more but less than 10,000 is "Normal level"; 
--          10,000 or more is "High level".
SELECT
    e.employee_id,
    e.first_name,
    e.salary,
    CASE
        WHEN e.salary <  5000                       THEN 'Low level'
        WHEN e.salary >= 5000  AND e.salary < 10000 THEN 'Normal level'
        WHEN e.salary >= 10000                      THEN 'High level'
        ELSE 'Unknown'
    END AS salary_level
FROM employees e;

-- Task 19: For each country, display its region: 1-Europe, 2-America, 3-Asia, 4-Africa. 
--          Complete this task without using JOIN; use DECODE instead.
SELECT *
FROM countries;

SELECT
    c.country_id,
    c.country_name,
    c.region_id,
    DECODE(c.region_id,
           1, 'Europe',
           2, 'America',
           3, 'Asia',
           4, 'Africe',
              'Unknown') AS region
FROM countries c;

-- Task 20: Solve task #19 using CASE.
SELECT
    c.country_id,
    c.country_name,
    c.region_id,
    CASE c.region_id
        WHEN 1 THEN 'Europe'
        WHEN 2 THEN 'America'
        WHEN 3 THEN 'Asia'
        WHEN 4 THEN 'Africe'
        ELSE 'Unknown'
    END AS region
FROM countries c;

-- Task 21: Display the employee's name, salary, and a rating of their compensation conditions: 
--          BAD: salary less than 10,000 and no commission; 
--          NORMAL: salary between 10,000 and 15,000 OR commission is present; 
--          GOOD: salary greater than or equal to 15,000.
SELECT 
    e.employee_id,
    e.first_name || ' ' || e.last_name AS full_name,
    e.salary,
    e.commission_pct,
    CASE
        WHEN e.salary < 10000                 AND e.commission_pct IS NULL     THEN 'BAD'
        WHEN e.salary BETWEEN 10000 AND 15000 OR  e.commission_pct IS NOT NULL THEN 'NORMAL'
        WHEN e.salary >= 15000                                                 THEN 'GOOD'
        ELSE 'Unknown'
    END AS compensation_status
FROM employees e;