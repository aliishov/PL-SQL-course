-- Task 1: Using functions, retrieve a list of all employees whose names contain 
--         the letter 'b' (case-insensitive).
SELECT *
FROM employees e
WHERE INSTR(LOWER(e.first_name), 'b') > 0;

-- Task 2: Using functions, retrieve a list of all employees whose names contain
--         at least two 'a's.
SELECT *
FROM employees e
WHERE LOWER(e.first_name) LIKE '%a%a%';

SELECT *
FROM employees e
WHERE INSTR(LOWER(e.first_name), 'a', 1, 2) > 0;

-- Task 3: Retrieve the first word of the department name for departments with 
--         names consisting of more than one word.
SELECT
    d.department_name,
    SUBSTR(d.department_name, 1, INSTR(d.department_name, ' ') - 1) AS departmetn_name_short
FROM departments d
WHERE INSTR(d.department_name, ' ') > 0;

-- Task 4: Retrieve employee names with the first and last letters removed.
SELECT 
    e.first_name,
    SUBSTR(e.first_name, 2, LENGTH(e.first_name) - 2) AS first_name_short
FROM employees e;

-- Task 5: Retrieve a list of all employees where the `job_id` value has at least 
--         3 characters after the underscore ('_'), but the part after the underscore is not 'CLERK'.
SELECT *
FROM employees e
WHERE LENGTH(SUBSTR(e.job_id, INSTR(e.job_id, '_') + 1)) >= 3 
  AND SUBSTR(e.job_id, INSTR(e.job_id, '_') + 1) <> 'CLERK';
    
-- Task 6: Retrieve a list of all employees who started work on the first day of any month.
SELECT *
FROM employees e
WHERE TO_CHAR(e.hire_date, 'DD') = '01';

-- Task 7: Retrieve a list of all employees who started work in 2008.
SELECT *
FROM employees e
WHERE TO_CHAR(e.hire_date, 'YYYY') = '2008';

-- Task 8: Display tomorrow's date in the format: Tomorrow is Second day of January.
SELECT TO_CHAR(DATE '2026-01-02', 'fm"Tomorrow is "Ddspth "day of "Month') AS text
FROM dual;

-- Task 9: Display the employee's name and their start date in the format: 21st of June, 2007.
SELECT 
    e.first_name,
    e.hire_date,
    TO_CHAR(e.hire_date, 'fmDdth "of "Month", "YYYY') AS start_date_text
FROM employees e;

-- Task 10: Retrieve a list of employees with their salaries increased by 20%. 
--          Display the salary in the format: $28,800.00.
SELECT
    e.employee_id,
    e.first_name,
    e.last_name,
    e.salary,
    e.salary + (e.salary * 0.20) AS increased_salary,
    TO_CHAR(e.salary + (e.salary * 0.20), '$999,999.99') AS increased_salary_text
FROM employees e;

-- Task 11: Display the current date, plus a second, a minute, an hour, a day, 
--          a month, and a year (each added separately to the current date).
SELECT 
    SYSDATE                      AS now,
    SYSDATE + 1 / (24 * 60 * 60) AS plus_second,
    SYSDATE + 1 / (24 * 60)      AS plus_minute,
    SYSDATE + 1 / 24             AS plus_hour,
    SYSDATE + 1                  AS plus_day,
    ADD_MONTHS(SYSDATE, 1)       AS plus_month,
    ADD_MONTHS(SYSDATE, 12)      AS plus_year
FROM dual;